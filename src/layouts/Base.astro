    })(window, document);
  </script>
  <!-- i18n -->
  <script type="module" src="/i18n/i18n.js"></script>

</head>
<body>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">yeah<span>dev</span> <span class="version">v2.10</span></a>
      <nav class="nav">
        <div class="nav-dropdown">
          <a href="/#articles" class="nav-dropdown-trigger"><span data-i18n="nav.articles">Articles</span> <span class="nav-caret">▾</span></a>
          <div class="nav-dropdown-menu">
            <a href="/articles/best-free-ai-video-tools-2026" data-i18n="nav.article1">Top 5 AI Explainer Tools of 2026</a>
            <a href="/articles/high-volume-low-energy-video-guide-2026" data-i18n="nav.article2">High-Volume "Low-Energy" Video Guide</a>
            <a href="/articles/meilleurs-moments-newsletter-video-2026" data-i18n="nav.article6">Meilleurs Moments Newsletter &amp; Vidéo</a>
            <a href="/articles/how-to-test-seo-og-2026" data-i18n="nav.article4">How to Test Your SEO &amp; OG Image</a>
            <a href="/articles/best-free-news-sources-2026" data-i18n="nav.article5">Best Free News Sources 2026</a>
            <a href="/articles/brand-image-campaigns-strategic-justification" data-i18n="nav.article3">Beyond the Click: Brand Image Campaigns</a>
            <a href="/articles/installing-as-an-app" data-i18n="nav.article7">Installing Our Apps on Your Phone</a>
          </div>
        </div>
        <a href="/#topics" data-i18n="nav.topics">Topics</a>
        <a href="/#about" data-i18n="nav.about">About</a>

        <!-- Language Toggle -->
        <div class="lang-toggle" role="group" aria-label="Language">
          <button class="lang-toggle-btn active" data-lang="en" aria-pressed="true">EN</button>
          <span class="lang-divider">|</span>
          <button class="lang-toggle-btn" data-lang="fr" aria-pressed="false">FR</button>
        </div>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer" id="about">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo">yeah<span>dev</span></a>
        <p data-i18n="footer.tagline">No-nonsense articles for people building something real.</p>
      </div>
      <div class="footer-links">
        <a href="/#articles" data-i18n="nav.articles">Articles</a>
        <a href="/#topics" data-i18n="nav.topics">Topics</a>
        <a href="https://happybein.com" target="_blank" rel="noopener">happybein.com</a>
        <a href="mailto:contact@happybein.com" data-i18n="footer.contact">Contact</a>
        <a href="https://happybein.com/privacy" target="_blank" rel="noopener">Privacy</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <span data-i18n="footer.copy">© 2026 YeahDev. Free to read, always.</span>
      <span class="footer-by">A <a href="https://happybein.com" target="_blank" rel="noopener">happybein.com</a> initiative</span>
