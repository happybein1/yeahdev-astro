---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  articleDate?: string;
  articleTag?: string;
  articleAuthor?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-home.png',
  ogType = 'website',
  canonicalUrl,
  articleDate,
  articleTag,
  articleAuthor = 'YeahDev',
} = Astro.props;

const siteUrl = 'https://yeahdev.com';
const canonical = canonicalUrl ?? siteUrl + Astro.url.pathname;
const ogImageAbsolute = siteUrl + ogImage;

const jsonLd = ogType === 'article'
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": articleDate,
      "image": ogImageAbsolute,
      "author": { "@type": "Organization", "name": articleAuthor, "url": siteUrl },
      "publisher": {
        "@type": "Organization",
        "name": "YeahDev",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": siteUrl + "/images/og-home.png", "width": 1200, "height": 630 }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "YeahDev",
      "url": siteUrl,
      "description": "Practical articles to help you build and grow your initiative.",
      "publisher": {
        "@type": "Organization",
        "name": "YeahDev",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": siteUrl + "/images/og-home.png", "width": 1200, "height": 630 }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": siteUrl + "/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    };
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={articleTag ? `${articleTag}, initiative, marketing, AI tools, yeahdev` : 'initiative articles, marketing strategy, AI tools, founders, builders'} />
  <meta name="author" content="YeahDev" />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Open Graph — image is exactly 1200×630 -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:secure_url" content={ogImageAbsolute} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="YeahDev — Practical knowledge to build your initiative" />
  <meta property="og:site_name" content="YeahDev" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@yeahdev" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />
  <meta name="twitter:image:alt" content="YeahDev — Practical knowledge to build your initiative" />

  <!-- Article-specific OG -->
  {articleDate && <meta property="article:published_time" content={articleDate} />}
  {articleDate && <meta property="article:modified_time" content={articleDate} />}
  {articleTag && <meta property="article:tag" content={articleTag} />}
  {ogType === 'article' && <meta property="article:author" content={siteUrl} />}
  {ogType === 'article' && <meta property="article:section" content={articleTag ?? 'Business'} />}

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/styles/global.css" />
  {ogType === 'article' && <link rel="stylesheet" href="/styles/article.css" />}

  <!-- Google Analytics -->
  <!-- Visit counts (Cloudflare Web Analytics, cookieless) + owner-traffic marker (yv-internal v5; source: _shared/internal.js) -->
  <script is:inline>
    (function (w, d) {
      var p = w.location.hostname.split('.'), dom = p.length >= 2 && !/^[\d.]+$/.test(w.location.hostname) ? '; domain=.' + p.slice(-2).join('.') : '';
      var here = p.slice(-2).join('.');
      var m = (w.location.search.match(/[?&]internal(?:=([^&]*))?(?:&|$)/) || [])[0], on = null;
      if (m) on = !/=off/.test(m);
      if (on !== null) {
        try { d.cookie = 'yv_internal=' + (on ? '1' : '') + '; max-age=' + (on ? 31536000 : 0) + '; path=/' + dom + '; SameSite=Lax' + (w.location.protocol === 'https:' ? '; Secure' : ''); } catch (e) {}
        try { if (on) w.localStorage.setItem('yv_internal', '1'); else w.localStorage.removeItem('yv_internal'); } catch (e) {}
      }
      var internal = false;
      try { internal = w.localStorage.getItem('yv_internal') === '1'; } catch (e) {}
      if (!internal) internal = /(?:^|;\s*)yv_internal=1/.test(d.cookie || '');
      if (here !== 'yeahvibe.com') {
        try {
          d.cookie.split('; ').map(function (c) { return c.split('=')[0]; })
            .filter(function (n) { return n === '_ga' || n.indexOf('_ga_') === 0 || n === '_gid' || n === 'yv_consent'; })
            .forEach(function (n) { ['', '; domain=' + w.location.hostname, dom].forEach(function (x) { d.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + x; }); });
          w.localStorage.removeItem('yv_consent');
        } catch (e) {}
      }
      var CF = { 'happybein.com': 'bc29302dbc214188aebf56490bf4cef4', 'yeahdev.com': 'eb13518849014d5e9fd376c4202f3432', 'yeahvibe.com': '55aea6e64e384cf7b021e272ff38d389' }[here];
      if (CF && !internal) {
        var b = d.createElement('script');
        b.defer = true; b.src = 'https://static.cloudflareinsights.com/beacon.min.js';
        b.setAttribute('data-cf-beacon', JSON.stringify({ token: CF }));
        (d.head || d.documentElement).appendChild(b);
      }
      if (on === null && !internal) return;
      var others = ['happybein.com', 'yeahvibe.com', 'yeahdev.com'].filter(function (x) { return x !== here; });
      var A = 'style="color:#6fdcd8"';
      function pill() {
        if (!internal) return;
        var v = d.querySelector('#version-refresh, .yv-version, .header-version, .ver, .version');
        if (v) {
          var cs = w.getComputedStyle(v), dot = d.createElement('span');
          if (cs.position === 'static') v.style.position = 'relative';
          dot.setAttribute('aria-hidden', 'true');
          dot.style.cssText = 'position:absolute;left:50%;top:calc(100% - ' + (parseFloat(cs.paddingBottom) || 0) + 'px + 1px);width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#2ABFBF;pointer-events:none';
          v.appendChild(dot);
          v.title = (v.title ? v.title + ' · ' : '') + 'Internal: your visits are not counted in the analytics';
