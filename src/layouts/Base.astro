---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  articleDate?: string;
  articleTag?: string;
  articleAuthor?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-home.png',
  ogType = 'website',
  canonicalUrl,
  articleDate,
  articleTag,
  articleAuthor = 'YeahDev',
} = Astro.props;

const siteUrl = 'https://yeahdev.com';
const canonical = canonicalUrl ?? siteUrl + Astro.url.pathname;
const ogImageAbsolute = siteUrl + ogImage;

const jsonLd = ogType === 'article'
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": articleDate,
      "image": ogImageAbsolute,
      "author": { "@type": "Organization", "name": articleAuthor, "url": siteUrl },
      "publisher": {
        "@type": "Organization",
        "name": "YeahDev",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": siteUrl + "/images/og-home.png", "width": 1200, "height": 630 }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical }
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "YeahDev",
      "url": siteUrl,
      "description": "Practical articles to help you build and grow your initiative.",
      "publisher": {
        "@type": "Organization",
        "name": "YeahDev",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": siteUrl + "/images/og-home.png", "width": 1200, "height": 630 }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": siteUrl + "/?s={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    };
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={articleTag ? `${articleTag}, initiative, marketing, AI tools, yeahdev` : 'initiative articles, marketing strategy, AI tools, founders, builders'} />
  <meta name="author" content="YeahDev" />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <!-- Open Graph — image is exactly 1200×630 -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:secure_url" content={ogImageAbsolute} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="YeahDev — Practical knowledge to build your initiative" />
  <meta property="og:site_name" content="YeahDev" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@yeahdev" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />
  <meta name="twitter:image:alt" content="YeahDev — Practical knowledge to build your initiative" />

  <!-- Article-specific OG -->
  {articleDate && <meta property="article:published_time" content={articleDate} />}
  {articleDate && <meta property="article:modified_time" content={articleDate} />}
  {articleTag && <meta property="article:tag" content={articleTag} />}
  {ogType === 'article' && <meta property="article:author" content={siteUrl} />}
  {ogType === 'article' && <meta property="article:section" content={articleTag ?? 'Business'} />}

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/styles/global.css" />
  {ogType === 'article' && <link rel="stylesheet" href="/styles/article.css" />}

  <!-- Google Analytics -->
  <!-- GA4 loads only after the visitor accepts (yv-consent v1; source: _shared/consent.js) -->
<script is:inline>
(function (w, d) {
  var GA = 'G-TJFL5YQ705', PRIVACY = 'https://happybein.com/privacy', KEY = 'yv_consent', DAYS = 180;
  var TEXT = {
    en: { t: 'We would like to use Google Analytics (cookies) to see which parts of this site get used. No ads, and your data is never sold. You can change your mind at any time.', a: 'Accept', r: 'Decline', p: 'Privacy policy', h: 'Cookies' },
    nl: { t: 'We willen Google Analytics (cookies) gebruiken om te zien welke onderdelen van deze site worden gebruikt. Geen advertenties en je gegevens worden nooit verkocht. Je kunt je keuze altijd wijzigen.', a: 'Accepteren', r: 'Weigeren', p: 'Privacybeleid', h: 'Cookies' },
    fr: { t: 'Nous aimerions utiliser Google Analytics (cookies) pour savoir quelles parties du site sont utilisées. Pas de publicité, et vos données ne sont jamais vendues. Vous pouvez changer d’avis à tout moment.', a: 'Accepter', r: 'Refuser', p: 'Politique de confidentialité', h: 'Cookies' },
    es: { t: 'Nos gustaría usar Google Analytics (cookies) para saber qué partes del sitio se utilizan. Sin anuncios y tus datos nunca se venden. Puedes cambiar de opinión en cualquier momento.', a: 'Aceptar', r: 'Rechazar', p: 'Política de privacidad', h: 'Cookies' }
  };

  /* ---- stored choice ---- */
  function cookieDomain() {
    var h = w.location.hostname, p = h.split('.');
    if (p.length < 2 || /^[\d.]+$/.test(h) || h === 'localhost') return '';
    return '; domain=.' + p.slice(-2).join('.');
  }
  function read() {
    var raw = null, m = d.cookie.match(/(?:^|; )yv_consent=([^;]*)/);
    if (m) raw = decodeURIComponent(m[1]);
    if (!raw) { try { raw = w.localStorage.getItem(KEY); } catch (e) {} }
    if (!raw) return null;
    var parts = raw.split(':'), v = parts[0], ts = +parts[1] || 0;
    if ((v !== 'granted' && v !== 'denied') || !ts || Date.now() - ts > DAYS * 864e5) return null;
    return v;
  }
  function write(v) {
    var val = v + ':' + Date.now();
    try { d.cookie = KEY + '=' + encodeURIComponent(val) + '; max-age=' + DAYS * 86400 + '; path=/' + cookieDomain() + '; SameSite=Lax' + (w.location.protocol === 'https:' ? '; Secure' : ''); } catch (e) {}
    try { w.localStorage.setItem(KEY, val); } catch (e) {}
  }
  function clearGaCookies() {
    var names = d.cookie.split('; ').map(function (c) { return c.split('=')[0]; }).filter(function (n) { return n === '_ga' || n.indexOf('_ga_') === 0 || n === '_gid'; });
    var p = w.location.hostname.split('.'), doms = ['', '; domain=' + w.location.hostname];
    if (p.length >= 2) doms.push('; domain=.' + p.slice(-2).join('.'));
    names.forEach(function (n) { doms.forEach(function (dm) { d.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + dm; }); });
  }

  /* ---- Google Consent Mode (default state is decided before the page's own gtag('config')) ---- */
  w.dataLayer = w.dataLayer || [];
  function gtag() { w.dataLayer.push(arguments); }
  if (!w.gtag) w.gtag = gtag;
  var stored = read(), loaded = false;
  var def = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: stored === 'granted' ? 'granted' : 'denied' };
  gtag('consent', 'default', def);

  function loadGA() {
    if (loaded) return;
    loaded = true;
    var s = d.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA;
    (d.head || d.documentElement).appendChild(s);
  }
  function apply(v) {
    if (v === 'granted') {
      if (!loaded) {
        // Drop events queued before consent was given; only 'js' / 'config' / 'set' / consent entries are replayed.
        for (var i = w.dataLayer.length - 1; i >= 0; i--) { var q = w.dataLayer[i]; if (q && q[0] === 'event') w.dataLayer.splice(i, 1); }
        def.analytics_storage = 'granted'; loadGA();   // queued 'default' entry is replayed as granted
      }
      else { w['ga-disable-' + GA] = false; gtag('consent', 'update', { analytics_storage: 'granted' }); }
    } else {
      w['ga-disable-' + GA] = true;
      if (loaded) gtag('consent', 'update', { analytics_storage: 'denied' });
      clearGaCookies();
    }
  }
  if (stored === 'granted') loadGA();
  if (stored === 'denied') w['ga-disable-' + GA] = true;

  /* ---- banner ---- */
  var box = null;
  function lang() {
    var l = (d.documentElement.lang || w.navigator.language || 'en').slice(0, 2).toLowerCase();
    return TEXT[l] || TEXT.en;
  }
  function css() {
    if (d.getElementById('yvc-css')) return;
    var s = d.createElement('style');
    s.id = 'yvc-css';
    s.textContent =
      '#yvc{position:fixed;left:12px;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);z-index:2147483000;max-width:520px;margin:0 auto;box-sizing:border-box;padding:14px 16px;border-radius:14px;' +
      'font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#fff;color:#1f2933;border:1px solid #d5dde0;box-shadow:0 6px 28px rgba(0,0,0,.28)}' +
      '#yvc p{margin:0 0 12px}#yvc a{color:#0f8f8f;text-decoration:underline}' +
      '#yvc .yvc-b{display:flex;gap:10px}#yvc button{flex:1;min-height:44px;border-radius:10px;font:700 15px system-ui,-apple-system,Segoe UI,Roboto,sans-serif;cursor:pointer;border:2px solid #2ABFBF}' +
      '#yvc .yvc-a{background:#2ABFBF;color:#04302f}#yvc .yvc-r{background:transparent;color:inherit}' +
      '@media (prefers-color-scheme:dark){#yvc{background:#1b2423;color:#e8f0ef;border-color:#33423f}#yvc a{color:#6fdcd8}#yvc .yvc-a{color:#04302f}}';
    (d.head || d.documentElement).appendChild(s);
  }
  function close() { if (box && box.parentNode) box.parentNode.removeChild(box); box = null; }
  function show() {
    if (box || !d.body) return;
    css();
    var t = lang();
    box = d.createElement('div');
    box.id = 'yvc';
    box.setAttribute('role', 'dialog');
    box.setAttribute('aria-label', t.h);
    box.innerHTML = '<p>' + t.t + (PRIVACY ? ' <a href="' + PRIVACY + '" target="_blank" rel="noopener">' + t.p + '</a>' : '') + '</p>' +
      '<div class="yvc-b"><button type="button" class="yvc-r">' + t.r + '</button><button type="button" class="yvc-a">' + t.a + '</button></div>';
    box.querySelector('.yvc-a').onclick = function () { write('granted'); apply('granted'); close(); };
    box.querySelector('.yvc-r').onclick = function () { write('denied'); apply('denied'); close(); };
    d.body.appendChild(box);
  }
  function ready(fn) { if (d.body) fn(); else d.addEventListener('DOMContentLoaded', fn); }

  w.yvConsentOpen = function () { ready(show); };
  w.yvConsentState = function () { return read(); };
  var wantsOpen = /(?:[?&#])cookie-settings\b/.test(w.location.search + w.location.hash);
  if (!stored || wantsOpen) ready(show);
})(window, document);
</script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TJFL5YQ705');
  </script>
  <!-- i18n -->
  <script type="module" src="/i18n/i18n.js"></script>

</head>
<body>

  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">yeah<span>dev</span> <span class="version">v2.4</span></a>
      <nav class="nav">
        <div class="nav-dropdown">
          <a href="/#articles" class="nav-dropdown-trigger"><span data-i18n="nav.articles">Articles</span> <span class="nav-caret">▾</span></a>
          <div class="nav-dropdown-menu">
            <a href="/articles/best-free-ai-video-tools-2026" data-i18n="nav.article1">Top 5 AI Explainer Tools of 2026</a>
            <a href="/articles/high-volume-low-energy-video-guide-2026" data-i18n="nav.article2">High-Volume "Low-Energy" Video Guide</a>
            <a href="/articles/meilleurs-moments-newsletter-video-2026" data-i18n="nav.article6">Meilleurs Moments Newsletter &amp; Vidéo</a>
            <a href="/articles/how-to-test-seo-og-2026" data-i18n="nav.article4">How to Test Your SEO &amp; OG Image</a>
            <a href="/articles/best-free-news-sources-2026" data-i18n="nav.article5">Best Free News Sources 2026</a>
            <a href="/articles/brand-image-campaigns-strategic-justification" data-i18n="nav.article3">Beyond the Click: Brand Image Campaigns</a>
            <a href="/articles/installing-as-an-app" data-i18n="nav.article7">Installing Our Apps on Your Phone</a>
          </div>
        </div>
        <a href="/#topics" data-i18n="nav.topics">Topics</a>
        <a href="/#about" data-i18n="nav.about">About</a>

        <!-- Language Toggle -->
        <div class="lang-toggle" role="group" aria-label="Language">
          <button class="lang-toggle-btn active" data-lang="en" aria-pressed="true">EN</button>
          <span class="lang-divider">|</span>
          <button class="lang-toggle-btn" data-lang="fr" aria-pressed="false">FR</button>
        </div>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer" id="about">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo">yeah<span>dev</span></a>
        <p data-i18n="footer.tagline">No-nonsense articles for people building something real.</p>
      </div>
      <div class="footer-links">
        <a href="/#articles" data-i18n="nav.articles">Articles</a>
        <a href="/#topics" data-i18n="nav.topics">Topics</a>
        <a href="https://happybein.com" target="_blank" rel="noopener">happybein.com</a>
        <a href="mailto:happybein1@gmail.com" data-i18n="footer.contact">Contact</a>
        <a href="#cookie-settings" onclick="event.preventDefault();window.yvConsentOpen&&window.yvConsentOpen();">Cookie settings</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <span data-i18n="footer.copy">© 2026 YeahDev. Free to read, always.</span>
      <span class="footer-by">A <a href="https://happybein.com" target="_blank" rel="noopener">happybein.com</a> initiative</span>
    </div>
  </footer>

</body>
</html>
