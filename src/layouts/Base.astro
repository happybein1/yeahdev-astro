        }
        var b = d.createElement('button');
        b.type = 'button';
        b.innerHTML = '&#9679; internal';
        b.title = 'This browser is marked as internal: your visits are not counted in the analytics';
        b.style.cssText = 'position:fixed;left:8px;bottom:calc(env(safe-area-inset-bottom,0px) + 8px);z-index:2147482999;padding:3px 9px;border-radius:999px;border:0;font:600 11px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#1A3333;color:#6fdcd8;opacity:.75;cursor:pointer';
        b.onclick = function () { b.remove(); note(true); };
        d.body.appendChild(b);
      }
      function note(info) {
        var n = d.createElement('div');
        n.setAttribute('role', 'status');
        n.style.cssText = 'position:fixed;left:12px;right:12px;top:calc(env(safe-area-inset-top,0px) + 12px);z-index:2147483001;max-width:520px;margin:0 auto;padding:12px 16px;border-radius:12px;font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#1A3333;color:#fff;box-shadow:0 6px 28px rgba(0,0,0,.28)';
        n.innerHTML = (info ? 'This browser is marked as <b>internal</b> on ' + here + ': your visits are left out of the analytics. <a ' + A + ' href="' + w.location.pathname + '?internal=off">Remove the mark</a>'
                     : on ? '&#10003; This browser is now marked as <b>internal</b> on ' + here + ': your visits are left out of the analytics.'
                          : 'The internal mark is removed on ' + here + ': your visits count again.') +
          (info ? '' : ' Also on: ' + others.map(function (x) { return '<a ' + A + ' href="https://' + x + '/?internal' + (on ? '' : '=off') + '">' + x + '</a>'; }).join(' &middot; ')) +
          ' <button type="button" aria-label="Close" style="float:right;background:none;border:0;color:#fff;font-size:18px;cursor:pointer">&times;</button>';
        n.querySelector('button').onclick = function () { n.remove(); pill(); };
        d.body.appendChild(n);
      }
      var show = function () { if (on === null) pill(); else note(false); };
